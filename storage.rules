rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Avatar images remain client-managed, with strict type and size limits.
    match /{userId}/avatar.jpg {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Generated media and attachments are written only by trusted Cloud
    // Functions. Short-lived signed video upload URLs do not use these rules.
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Authenticated users can submit bounded image evidence with issue reports.
    match /issue_screenshots/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Deny all other Storage access.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
