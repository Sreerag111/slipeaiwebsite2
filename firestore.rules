rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function protectedServerFields() {
      return [
        'premium',
        'billing',
        'serverUsage',
        'isPremium',
        'subscriptionStatus',
        'planId',
        'paymentId',
        'orderId',
        'purchaseDate',
        'expiryDate'
      ];
    }

    // Subscription fields are written only by trusted Cloud Functions.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(protectedServerFields());
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(protectedServerFields());
      allow delete: if false;
    }

    // Users manage their own local chat history and conversation threads.
    match /users/{userId}/history/{historyId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/threads/{threadId} {
      allow read, write: if isOwner(userId);
    }

    // Enhancement records are authoritative Cloud Function output.
    match /users/{userId}/enhancements/{enhancementId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /feedback/{document=**} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    match /reports/{document=**} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Image presets can be read by any client (fallback to offline presets if unavailable).
    // Updates are managed via Firebase Console or administrative tooling.
    match /image_presets/{presetId} {
      allow read: if true;
      allow write: if false;
    }

    // App configuration (version control, maintenance, etc.) can be read by any client.
    match /app_config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
